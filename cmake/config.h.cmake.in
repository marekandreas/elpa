/* config.h.  Generated by CMake from config.h.cmake.in  */

/* ELPA can at runtime limit the number of OpenMP threads to 1 if needed */
#cmakedefine ALLOW_THREAD_LIMITING 1

/* use blocking in trans_ev_band_to_full */
#cmakedefine BAND_TO_FULL_BLOCKING 1

/* build for FUGAKU */
#cmakedefine BUILD_FUGAKU 1

/* build for K-Computer */
#cmakedefine BUILD_KCOMPUTER 1

/* build for SX-Aurora */
#cmakedefine BUILD_SXAURORA 1

/* "Current ELPA API version" */
#define CURRENT_API_VERSION @CURRENT_API_VERSION@

/* "Current ELPA autotune version" */
#define CURRENT_AUTOTUNE_VERSION @CURRENT_AUTOTUNE_VERSION@

/* "disable/enable NVIDIA GPU in C-headers" */
#define CURRENT_WITH_AMD_GPU_VERSION @CURRENT_WITH_AMD_GPU_VERSION@

/* "disable/enable NVIDIA GPU in C-headers" */
#define CURRENT_WITH_NVIDIA_GPU_VERSION @CURRENT_WITH_NVIDIA_GPU_VERSION@

/* "disable/enable SYCL GPU in C-headers" */
#define CURRENT_WITH_SYCL_GPU_VERSION @CURRENT_WITH_SYCL_GPU_VERSION@

/* enable CUDA debugging */
#cmakedefine DEBUG_CUDA 1

/* enable SYCL on CPU debugging */
#cmakedefine DEBUG_SYCL_ON_CPU 1

/* Earliest supported ELPA API version */
#define EARLIEST_API_VERSION @EARLIEST_API_VERSION@

/* Earliest ELPA API version, which supports autotuning */
#define EARLIEST_AUTOTUNE_VERSION @EARLIEST_AUTOTUNE_VERSION@

/* "Time of build" */
#define ELPA_BUILDTIME @ELPA_BUILDTIME@

/* enable autotuning functionality */
#cmakedefine ENABLE_AUTOTUNING 1

/* enable C++ tests */
#cmakedefine ENABLE_CPP_TESTS 1

/* enable C tests */
#cmakedefine ENABLE_C_TESTS 1

/* enable Fortran tests */
#cmakedefine ENABLE_FORTRAN_TESTS 1

/* enable ifx compiler builds */
#cmakedefine ENABLE_IFX_COMPILER 1

/* Work around a PGI/NVHPC bug with variable-length string results */
#cmakedefine PGI_VARIABLE_STRING_BUG 1

/* allow to link against the 64bit integer versions of math libraries */
#cmakedefine HAVE_64BIT_INTEGER_MATH_SUPPORT 1

/* allow to link against the 64bit integer versions of the MPI library */
#cmakedefine HAVE_64BIT_INTEGER_MPI_SUPPORT 1

/* Enable affinity checking */
#cmakedefine HAVE_AFFINITY_CHECKING 1

/* AVX is supported on this CPU */
#cmakedefine HAVE_AVX 1

/* AVX2 is supported on this CPU */
#cmakedefine HAVE_AVX2 1

/* AVX512 is supported on this CPU */
#cmakedefine HAVE_AVX512 1

/* AVX512 on Xeon (uses _mm512_xor_pd from AVX-512DQ) */
#cmakedefine HAVE_AVX512_XEON 1

/* AVX512 on Xeon Phi (uses _mm512_xor_epi64) */
#cmakedefine HAVE_AVX512_XEON_PHI 1

/* define if the compiler supports basic C++17 syntax */
#cmakedefine HAVE_CXX17 1

/* Enable more timing */
#cmakedefine HAVE_DETAILED_TIMINGS 1

/* Define to 1 if you have the <dlfcn.h> header file. */
#cmakedefine HAVE_DLFCN_H 1

/* Fortran can query environment variables */
#cmakedefine HAVE_ENVIRONMENT_CHECKING 1

/* automatically support clusters with different Intel CPUs */
#cmakedefine HAVE_HETEROGENOUS_CLUSTER_SUPPORT 1

/* Define to 1 if you have the <inttypes.h> header file. */
#cmakedefine HAVE_INTTYPES_H 1

/* can use module iso_fortran_env */
#cmakedefine HAVE_ISO_FORTRAN_ENV 1

/* Use the PAPI library */
#cmakedefine HAVE_LIBPAPI 1

/* Use likwid */
#cmakedefine HAVE_LIKWID 1

/* can use the Fortran mpi module */
#cmakedefine HAVE_MPI_MODULE 1

/* NEON_ARCH64 intrinsics are supported on this CPU */
#cmakedefine HAVE_NEON_ARCH64_SSE 1

/* Define to 1 to support Digital Random Number Generator */
#cmakedefine HAVE_RDRND 1

/* Redirect stdout and stderr of test programs per MPI tasks to a file */
#cmakedefine HAVE_REDIRECT 1

/* build for skewsymmetric case */
#cmakedefine HAVE_SKEWSYMMETRIC 1

/* SPARC64 intrinsics are supported on this CPU */
#cmakedefine HAVE_SPARC64_SSE 1

/* gcc intrinsics SSE is supported on this CPU */
#cmakedefine HAVE_SSE_INTRINSICS 1

/* Define to 1 if you have the <stdint.h> header file. */
#cmakedefine HAVE_STDINT_H 1

/* Define to 1 if you have the <stdio.h> header file. */
#cmakedefine HAVE_STDIO_H 1

/* Define to 1 if you have the <stdlib.h> header file. */
#cmakedefine HAVE_STDLIB_H 1

/* Define to 1 if you have the <strings.h> header file. */
#cmakedefine HAVE_STRINGS_H 1

/* Define to 1 if you have the <string.h> header file. */
#cmakedefine HAVE_STRING_H 1

/* MPI threading support is sufficient */
#cmakedefine HAVE_SUFFICIENT_MPI_THREADING_SUPPORT 1

/* SVE128 is supported on this CPU */
#cmakedefine HAVE_SVE128 1

/* SVE256 is supported on this CPU */
#cmakedefine HAVE_SVE256 1

/* SVE512 is supported on this CPU */
#cmakedefine HAVE_SVE512 1

/* Define to 1 if you have the <sys/stat.h> header file. */
#cmakedefine HAVE_SYS_STAT_H 1

/* Define to 1 if you have the <sys/types.h> header file. */
#cmakedefine HAVE_SYS_TYPES_H 1

/* Define to 1 if you have the <unistd.h> header file. */
#cmakedefine HAVE_UNISTD_H 1

/* Altivec VSX support */
#cmakedefine HAVE_VSX 1
#cmakedefine HAVE_VSX_SSE 1

/* use blocking in loops */
#cmakedefine LOOP_BLOCKING 1

/* Define to the sub-directory where libtool stores uninstalled libraries. */
#define LT_OBJDIR ".libs/"

/* need not to append an underscore */
#cmakedefine NEED_NO_UNDERSCORE_TO_LINK_AGAINST_FORTRAN 1

/* need to append an underscore */
#cmakedefine NEED_UNDERSCORE_TO_LINK_AGAINST_FORTRAN 1

/* enable error argument in C-API to be optional */
#cmakedefine OPTIONAL_C_ERROR_ARGUMENT 1

/* Name of package */
#define PACKAGE "elpa"

/* Define to the address where bug reports for this package should be sent. */
#define PACKAGE_BUGREPORT "elpa-library@mpcdf.mpg.de"

/* Define to the full name of this package. */
#define PACKAGE_NAME "elpa"

/* Define to the full name and version of this package. */
#define PACKAGE_STRING "elpa @PROJECT_VERSION@"

/* Define to the one symbol short name of this package. */
#define PACKAGE_TARNAME "elpa"

/* Define to the home page for this package. */
#define PACKAGE_URL ""

/* Define to the version of this package. */
#define PACKAGE_VERSION "@PROJECT_VERSION@"

/* In some kernels pack real to complex */
#cmakedefine PACK_REAL_TO_COMPLEX 1

/* enable matrix re-distribution during autotuning */
#cmakedefine REDISTRIBUTE_MATRIX 1

/* The size of 'long int', as computed by sizeof. */
#define SIZEOF_LONG_INT @SIZEOF_LONG_INT@

/* Define to 1 if all of the C89 standard headers exist */
#cmakedefine STDC_HEADERS 1

/* compile build config into the library object */
#cmakedefine STORE_BUILD_CONFIG 1

/* can check at runtime the threading support level of MPI */
#cmakedefine THREADING_SUPPORT_CHECK 1

/* for performance reasons use assumed size Fortran arrays */
#cmakedefine USE_ASSUMED_SIZE 1

/* use some Fortran 2008 features */
#cmakedefine USE_FORTRAN2008 1

/* Version number of package */
#define VERSION "@PROJECT_VERSION@"

/* build also single-precision for complex calculation */
#cmakedefine WANT_SINGLE_PRECISION_COMPLEX 1

/* build also single-precision for real calculation */
#cmakedefine WANT_SINGLE_PRECISION_REAL 1

/* use MPI */
#cmakedefine WITH_MPI 1

/* use OpenMP threading */
#cmakedefine WITH_OPENMP_TRADITIONAL 1

/* Fortran compiler supports !$omp masked (OpenMP 5.1) */
#cmakedefine HAVE_OMP_MASKED 1

/* enable Nvidia GPU support */
#cmakedefine WITH_NVIDIA_GPU_VERSION 1

/* Nvidia GPU kernel should be build */
#cmakedefine WITH_NVIDIA_GPU_KERNEL 1

/* Nvidia sm_80 GPU kernel should be build */
#cmakedefine WITH_NVIDIA_SM80_GPU_KERNEL 1

/* the NVIDIA GPU kernels for A100 can be used */
#cmakedefine WITH_NVIDIA_GPU_SM80_COMPUTE_CAPABILITY 1

/* enable CUDA cusolver */
#cmakedefine WITH_NVIDIA_CUSOLVER 1

/* enable streams in GPU code */
#cmakedefine WITH_GPU_STREAMS 1

/* enable CUDA-aware MPI */
#cmakedefine WITH_CUDA_AWARE_MPI 1

/* use cucub library in some kernels */
#cmakedefine WITH_CUCUB 1

/* enable NVTX support */
#cmakedefine WITH_NVTX 1

/* enable usage of NVIDIA NCCL */
#cmakedefine WITH_NVIDIA_NCCL 1

/* enable AMD GPU support */
#cmakedefine WITH_AMD_GPU_VERSION 1

/* AMD GPU kernel should be build */
#cmakedefine WITH_AMD_GPU_KERNEL 1

/* use hipblas instead of rocblas */
#cmakedefine HIPBLAS 1

/* use hipcub library in some kernels */
#cmakedefine WITH_HIPCUB 1

/* old hip memory type structure */
#cmakedefine HAVE_OLD_HIP_TYPESTRUCTURE 1

/* use rocblas API v3 */
#cmakedefine HAVE_ROCBLAS_API_V3 1

/* enable AMD hipsolver */
#cmakedefine WITH_AMD_HIPSOLVER_API 1

/* enable AMD rocsolver */
#cmakedefine WITH_AMD_ROCSOLVER 1

/* enable usage of AMD RCCL */
#cmakedefine WITH_AMD_RCCL 1

/* enable ROCTX support */
#cmakedefine WITH_ROCTX 1

/* enable INTEL GPU support via OpenMP backend */
#cmakedefine WITH_OPENMP_OFFLOAD_GPU_VERSION 1

/* enable INTEL GPU support via SYCL backend */
#cmakedefine WITH_SYCL_GPU_VERSION 1

/* enable SYCL solver */
#cmakedefine WITH_SYCL_SOLVER 1

/* enable usage of oneAPI oneCCL */
#cmakedefine WITH_ONEAPI_ONECCL 1

/* build and install python wrapper */
#cmakedefine WITH_PYTHON 1

/* build SCALAPACK test cases */
#cmakedefine WITH_SCALAPACK_TESTS 1

/* use only one specific real kernel (set at compile time) */
#cmakedefine WITH_FIXED_REAL_KERNEL 1

/* use only one specific complex kernel (set at compile time) */
#cmakedefine WITH_FIXED_COMPLEX_KERNEL 1

/* Build real kernels */
#cmakedefine WITH_REAL_GENERIC_KERNEL 1
#cmakedefine WITH_REAL_GENERIC_SIMPLE_KERNEL 1
#cmakedefine WITH_REAL_GENERIC_SIMPLE_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_GENERIC_SIMPLE_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_BGP_KERNEL 1
#cmakedefine WITH_REAL_BGQ_KERNEL 1
#cmakedefine WITH_REAL_SSE_ASSEMBLY_KERNEL 1
#cmakedefine WITH_REAL_SSE_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_SSE_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_SSE_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_AVX_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_AVX_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_AVX_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_AVX2_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_AVX2_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_AVX2_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_AVX512_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_AVX512_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_AVX512_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_SVE128_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_SVE128_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_SVE128_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_SVE256_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_SVE256_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_SVE256_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_SVE512_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_SVE512_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_SVE512_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_SPARC64_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_SPARC64_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_SPARC64_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_NEON_ARCH64_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_NEON_ARCH64_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_NEON_ARCH64_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_VSX_BLOCK2_KERNEL 1
#cmakedefine WITH_REAL_VSX_BLOCK4_KERNEL 1
#cmakedefine WITH_REAL_VSX_BLOCK6_KERNEL 1
#cmakedefine WITH_REAL_NVIDIA_GPU_KERNEL 1
#cmakedefine WITH_REAL_NVIDIA_SM80_GPU_KERNEL 1
#cmakedefine WITH_REAL_AMD_GPU_KERNEL 1
#cmakedefine WITH_REAL_INTEL_GPU_SYCL_KERNEL 1

/* Build complex kernels */
#cmakedefine WITH_COMPLEX_GENERIC_KERNEL 1
#cmakedefine WITH_COMPLEX_GENERIC_SIMPLE_KERNEL 1
#cmakedefine WITH_COMPLEX_BGP_KERNEL 1
#cmakedefine WITH_COMPLEX_BGQ_KERNEL 1
