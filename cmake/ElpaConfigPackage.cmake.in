@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Re-discover the math libraries that the ELPA library was built against.
set(_elpa_math_libraries)
set(ELPA_WITH_MKL @WITH_MKL@)
set(ELPA_64BIT_INTEGER_MATH @ELPA_64BIT_INTEGER_MATH@)
set(ELPA_MPI @ELPA_MPI@)
set(ELPA_WITH_OPENMP_TRADITIONAL @WITH_OPENMP_TRADITIONAL@)

if(ELPA_WITH_MKL)
    set(MKL_ARCH "@MKL_ARCH@")
    set(MKL_LINK "@MKL_LINK@")
    set(MKL_THREADING "@MKL_THREADING@")
    set(MKL_INTERFACE "@MKL_INTERFACE@")
    if(NOT "@MKL_MPI@" STREQUAL "")
        set(MKL_MPI "@MKL_MPI@")
    endif()
    if(ELPA_MPI)
        set(ENABLE_BLACS ON)
        set(ENABLE_SCALAPACK ON)
    endif()
    find_dependency(MKL CONFIG REQUIRED)
    list(APPEND _elpa_math_libraries MKL::MKL)
else()
    if(ELPA_64BIT_INTEGER_MATH)
        set(BLA_SIZEOF_INTEGER 8)
    else()
        set(BLA_SIZEOF_INTEGER 4)
    endif()
    find_dependency(BLAS REQUIRED)
    find_dependency(LAPACK REQUIRED)
    list(APPEND _elpa_math_libraries BLAS::BLAS LAPACK::LAPACK)

    if(ELPA_MPI)
        find_library(
            _elpa_scalapack_library
            NAMES scalapack mpiscalapack scalapack-openmpi scalapack-mpich
        )
        if(NOT _elpa_scalapack_library)
            set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
            set(
                ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
                "Could not find the ScaLAPACK dependency"
            )
            return()
        endif()
        list(APPEND _elpa_math_libraries "${_elpa_scalapack_library}")
    endif()
endif()

if(NOT TARGET ELPA::scalapack)
    add_library(ELPA::scalapack INTERFACE IMPORTED)
    set_property(
        TARGET ELPA::scalapack
        PROPERTY INTERFACE_LINK_LIBRARIES "${_elpa_math_libraries}"
    )
endif()
unset(_elpa_math_libraries)
unset(_elpa_scalapack_library)

if(ELPA_MPI)
    find_dependency(MPI COMPONENTS C Fortran)
endif()
if(ELPA_WITH_OPENMP_TRADITIONAL)
    find_dependency(OpenMP COMPONENTS C Fortran)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ElpaTargets.cmake")
check_required_components(Elpa)
