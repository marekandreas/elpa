prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@ELPA_PC_LIBDIR@
includedir=@ELPA_PC_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lelpa
Libs.private: @ELPA_PC_PRIVATE_LIBS@
Cflags: -I${includedir} -I@ELPA_PC_FMODDIR@
